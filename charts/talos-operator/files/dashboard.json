        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(talos_operator_cluster_approval_pending{taloscluster=\"$taloscluster\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
