              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Operations over time",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
