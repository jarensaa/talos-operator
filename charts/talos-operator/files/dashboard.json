        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (state) (talos_operator_operation_turns{taloscluster=\"$taloscluster\"})",
