        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 22,
        "y": 5,
        "w": 2,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(talos_operator_cluster_etcd_members{taloscluster=\"$taloscluster\", role=\"learner\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
