        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "component": 0,
              "running": 1,
              "desired": 2
            },
            "renameByName": {}
          }
        }
      ]
    },
