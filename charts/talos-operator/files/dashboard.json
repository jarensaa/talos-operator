      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 10,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (type, machine, step, reason, hook) (talos_operator_operation_failure_info{taloscluster=\"$taloscluster\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
